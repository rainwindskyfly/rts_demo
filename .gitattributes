# Normalise line endings: the repository stores LF, Windows checkouts get CRLF.
* text=auto eol=lf

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binary-ish files
*.exe   binary
*.pck   binary
*.zip   binary
*.png   binary
*.ico   binary
